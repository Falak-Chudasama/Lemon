<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6120D0A"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#26FFFFFF"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/tvBlockedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/host_grotesk_bold"
            android:text="Application Snapped"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/urbanist_regular"
            android:text="Stay focused on what matters today."
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnReturnHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#A26C3D"
            android:fontFamily="@font/urbanist_semibold"
            android:text="Return Home"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</FrameLayout>

